{
  "name": "junamis-skills",
  "version": "1.0.0",
  "description": "Install and manage Agent Skills (SKILL.md workflows) for any AI coding agent. Pins third-party skills by manifest and copies them into each agent's global skills directory.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "skill-md",
    "claude",
    "opencode",
    "coding-agents"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "junamis-skills": "bin/junamis-skills.js"
  },
  "files": [
    "bin",
    "src",
    "library",
    "skills-lock.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "install:external": "node src/install-external.js"
  },
  "packageManager": "pnpm@12.15.0",
  "main": "src/cli.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/devenius/junamis-skills.git"
  },
  "homepage": "https://github.com/devenius/junamis-skills#readme",
  "bugs": {
    "url": "https://github.com/devenius/junamis-skills/issues"
  }
}
