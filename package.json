{
  "name": "@devenius/junamis-skills",
  "version": "1.0.0",
  "description": "Install and manage Agent Skills (SKILL.md workflows) for any AI coding agent. Pins third-party skills by manifest and copies them into each agent's global skills directory.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "skill-md",
    "claude",
    "opencode",
    "coding-agents"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "bin": {
    "junamis-skills": "bin/junamis-skills.js",
    "junamis-orchestrator": "scripts/orchestrator-state.mjs",
    "junamis-design-registry": "scripts/design-registry.mjs",
    "junamis-reconcile": "scripts/reconcile.mjs"
  },
  "files": [
    "bin",
    "dist",
    "library",
    "scripts/orchestrator-state.mjs",
    "scripts/design-registry.mjs",
    "scripts/reconcile.mjs",
    "docs/design/_schema.md",
    "docs",
    "skills-lock.json",
    "SECURITY.md",
    "junamis-skills.yml",
    "opencode.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.types.json",
    "test": "pnpm build && pnpm typecheck && node --test test/*.test.js",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "check:config": "node scripts/check-opencode-config.mjs",
    "check:skills-lock": "node scripts/check-skills-lock.mjs",
    "check:pack": "pnpm build && node scripts/check-pack.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check:yaml": "node scripts/check-yaml.js"
  },
  "packageManager": "pnpm@12.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devenius/junamis-skills.git"
  },
  "homepage": "https://github.com/devenius/junamis-skills#readme",
  "bugs": {
    "url": "https://github.com/devenius/junamis-skills/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "js-yaml": "^5.5.0",
    "typescript": "^7.0.2"
  }
}
